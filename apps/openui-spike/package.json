{
  "name": "@goblin/openui-spike",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18983 --strictPort",
    "build": "vite build",
    "typecheck": "bun ../../tools/typecheck.ts tsconfig.json",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "test:unit": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "test:browser": "bun test/browser.ts",
    "plan": "alchemy plan --stage preview --config alchemy.run.ts",
    "deploy": "alchemy deploy --stage preview --config alchemy.run.ts --yes"
  },
  "dependencies": {
    "@goblin/kit": "workspace:*",
    "@goblin/ui": "workspace:*",
    "@goblin/web": "workspace:*",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.7",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
