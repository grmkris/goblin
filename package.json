{
  "name": "goblin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/stage.ts dev",
    "build": "turbo run build",
    "deploy:dev": "bun scripts/stage.ts deploy:dev",
    "plan:dev": "bun scripts/stage.ts plan:dev",
    "destroy:dev": "bun scripts/stage.ts destroy:dev",
    "smoke:dev": "bun --env-file .local/dev.env scripts/smoke-dev.ts",
    "ui:acceptance": "bun scripts/ui-acceptance.ts",
    "smoke:local": "GOBLIN_STAGE=local GOBLIN_APP_URL=http://localhost:18971 bun --env-file .local/local.env scripts/smoke-dev.ts",
    "icons": "bun scripts/app-icons.ts",
    "fmt": "oxfmt -c oxfmt.config.ts --write",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:gate": "bun tools/lint-gate.ts",
    "lint:report": "bun tools/lint-report.ts",
    "knip": "knip --no-progress",
    "dupes": "jscpd",
    "typecheck": "bun tools/typecheck.ts --workspaces tsconfig.json",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:integration:permuted": "turbo run test:integration:permuted",
    "agents:check": "bun x repoagents@1.1.0 check && bun tools/agents-check.ts",
    "check:files": "bun tools/check-files.ts",
    "check:terms": "bun tools/check-terms.ts",
    "check:patches": "bun tools/check-patches.ts",
    "goblin": "bun apps/cli/src/main.ts",
    "graph": "bun tools/check-graph.ts",
    "check:fast": "bun run test:release && bun run fmt:check && bun run agents:check && bun run check:patches && bun run check:chat-ids && bun run check:terms && bun run lint && bun run typecheck && bun run test:unit",
    "check": "bun run test:release && bun run fmt:check && bun run agents:check && bun run check:patches && bun run check:chat-ids && bun run check:terms && bun run graph && bun run typecheck && bun run lint:gate --skip effect && bun run dupes && bun run test && bun run test:integration && bun run test:integration:permuted && bun run build",
    "deploy:prod": "bun scripts/stage.ts deploy:prod",
    "plan:prod": "bun scripts/stage.ts plan:prod",
    "destroy:prod": "bun scripts/stage.ts destroy:prod",
    "smoke:prod": "bun scripts/stage.ts smoke:prod",
    "drift:dev": "bun scripts/stage.ts drift:dev",
    "drift:prod": "bun scripts/stage.ts drift:prod",
    "release": "python3 -B scripts/release.py",
    "check:chat-ids": "bun tools/check-chat-ids.ts",
    "promote": "python3 -B scripts/promote.py",
    "test:release": "python3 -B scripts/release_test.py && python3 -B scripts/promote_test.py && python3 -B scripts/ci_credentials_test.py"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.3",
    "@shadcn/lint": "0.2.3",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.5",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5",
    "jscpd": "5.4.1",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-complexity": "4.0.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "turbo": "2.11.9",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@better-auth/oauth-provider": "1.7.11",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/sql-d1": "4.0.5",
    "@effect/sql-sqlite-do": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@hono/node-server": "1.19.17",
    "hono": "4.13.13",
    "lodash": "4.18.1",
    "tinypool": "2.2.0",
    "valibot": "1.5.0",
    "ws": "8.22.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@shadcn/react@0.3.1": "patches/@shadcn%2Freact@0.3.1.patch",
    "@openuidev/react-lang@1.0.1": "patches/@openuidev%2Freact-lang@1.0.1.patch"
  }
}
