{
  "name": "goblin-desktop-toolkit-matrix",
  "version": "0.1.0",
  "private": true,
  "workspaces": [],
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:browser": "NODE_PATH=\"$PWD/node_modules\" bun --tsconfig-override tsconfig.json scripts/browser.ts",
    "check": "bun run typecheck && bun run test && bun run build && bun run test:browser",
    "tauri:dev": "cd tauri && ../node_modules/.bin/tauri dev",
    "tauri:build": "cd tauri && ../node_modules/.bin/tauri build --no-bundle",
    "electrobun:dev": "bun --cwd electrobun run dev",
    "electrobun:build": "bun --cwd electrobun run build",
    "serve": "NODE_PATH=\"$PWD/node_modules\" bun --tsconfig-override tsconfig.json service/main.ts",
    "test": "NODE_PATH=\"$PWD/node_modules\" bun test --tsconfig-override ./tsconfig.json service/test",
    "launch": "bun scripts/launch.ts"
  },
  "dependencies": {
    "@goblin/contracts": "file:../../packages/contracts",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/bun": "1.3.9",
    "@types/node": "22.18.0",
    "electrobun": "2.0.2",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
