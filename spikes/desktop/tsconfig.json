{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["bun", "node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "effect": ["./node_modules/effect"],
      "effect/*": ["./node_modules/effect/*"],
      "@goblin/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["shared/src", "service", "scripts"]
}
