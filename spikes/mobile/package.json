  "workspaces": [],
  "type": "module",
  "scripts": {
    "dev": "one dev --port 18980",
    "build": "one build",
    "build:ios": "one build --platform ios",
    "build:android": "one build --platform android",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "node scripts/browser.ts",
    "check": "bun run typecheck && bun run test",
