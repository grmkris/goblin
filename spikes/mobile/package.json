    "@react-navigation/native": "8.0.0-alpha.50",
    "effect": "4.0.1",
    "one": "2.6.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.0.0",
    "react-native-reanimated": "4.6.0",
    "react-native-screens": "4.27.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@react-native-community/template": "0.87.1",
    "@types/node": "22.18.0",
    "@types/react": "19.2.14",
    "playwright-core": "1.63.0",
