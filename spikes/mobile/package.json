    "android": "one run:android",
    "test:local": "cd ../.. && node apps/runtime/node_modules/vitest/vitest.mjs run --config spikes/mobile/vitest.local.config.ts"
  },
  "dependencies": {
    "@goblin/contracts": "file:../../packages/contracts",
    "@react-navigation/core": "8.0.0-alpha.40",
