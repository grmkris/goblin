{
  "name": "@goblin/app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./toolchain": {
      "types": "./src/toolchain.d.ts",
      "default": "./dist/toolchain.js"
    },
    "./runtime/*": "./dist/runtime/*"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bun ../../tools/typecheck.ts tsconfig.json tsconfig.ui.json tsconfig.render.json",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "test:unit": "vitest run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "dependencies": {
    "@goblin/kit": "workspace:*",
    "@goblin/ui": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "leaflet": "1.9.4",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sucrase": "3.35.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@types/bun": "1.4.2",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
